{
  "name": "boardingfinder-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.108.4",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "laravel-echo": "^2.6.3",
    "pusher-js": "^8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@tanstack/.*|laravel-echo|pusher-js))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  }
}
