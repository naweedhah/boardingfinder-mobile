# Copy to .env.local. EXPO_PUBLIC_* values are inlined into the app bundle, so never put secrets here.

# The Laravel API. On a physical phone use your computer's LAN IP, not localhost
# (for example http://192.168.1.20:8000). The Android emulator reaches the host at 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Laravel Reverb (WebSockets) for live chat. Must match REVERB_APP_KEY / host / port in the API's .env.
EXPO_PUBLIC_REVERB_KEY=boardingfinder-local-key
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
